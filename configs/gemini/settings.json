{
  "mcpServers": {
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp",
      "type": "http"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp/oauth",
      "type": "http"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "type": "http"
    }
  },
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "token-economy-reminder",
            "type": "command",
            "command": "echo 'token-conserve: lead with result; terse; surgical edits; one targeted question if ambiguous'",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "name": "guidance-hint",
            "type": "command",
            "command": "~/.claude/scripts/guidance_hint.py",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
