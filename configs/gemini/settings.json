{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp/oauth",
      "type": "http"
    }
  },
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "token-economy-reminder",
            "type": "command",
            "command": "echo 'token-conserve: lead with result; terse; surgical edits; one targeted question if ambiguous'",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "name": "guidance-hint",
            "type": "command",
            "command": "~/.claude/scripts/guidance_hint.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "name": "spec-review",
            "type": "command",
            "command": "~/.claude/scripts/spec_review.sh --silent",
            "timeout": 120000
          },
          {
            "name": "lint-on-edit",
            "type": "command",
            "command": "~/.claude/scripts/lint_on_edit_hook.sh",
            "timeout": 30000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "deploy-stamp-check",
            "type": "command",
            "command": "~/.claude/scripts/deploy_stamp_check.sh",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
