{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "~/.local/bin/uv run --quiet --no-project --with pyyaml --python 3.11 ~/.cursor/scripts/guidance_hint.py",
        "type": "command"
      }
    ],
    "afterFileEdit": [
      {
        "command": "~/.cursor/scripts/spec_review.sh --silent \"$CLAUDE_PROJECT_DIR\"",
        "type": "command"
      },
      {
        "command": "~/.cursor/scripts/lint_on_edit_hook.sh",
        "type": "command"
      }
    ],
    "sessionStart": [
      {
        "command": "~/.cursor/scripts/deploy_stamp_check.sh",
        "type": "command"
      }
    ]
  }
}
