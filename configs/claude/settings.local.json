      "Bash(~/.claude/scripts/label_sync.sh:*)",
      "Bash(~/.claude/scripts/linear_ops.sh:*)",
      "Bash(~/.claude/scripts/version_pin.sh:*)",
      "Bash(~/.claude/scripts/version_pin_hook.sh:*)",
      "Bash(~/.claude/scripts/pr_review.sh:*)",
      "Bash(~/.claude/scripts/branch_clean.sh:*)",
      "Bash(~/.claude/scripts/command_catalog.py:*)",
      "Bash(~/.claude/scripts/generate_commands_doc.py:*)",
      "Bash(~/.claude/scripts/guidance_hint.py:*)",
      "Bash(~/.claude/scripts/subagent_model_default.py:*)",
      "Bash(~/.claude/scripts/subagent_breakdown.py:*)",
      "Bash(shellcheck:*)",
      "Bash(python3:*)",
      "Bash(pip3 install:*)",
      "Bash(pre-commit run:*)",
      "Bash(chmod:*)",
      "Bash(ls:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(glab issue:*)",
      "Bash(~/.claude/scripts/deploy_stamp_check.sh:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:docs.github.com)"
    ]
  },
  "mcpServers": {
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.context7.com/mcp/oauth"
      ]
    },
    "linear": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ]
    },
    "atlassian": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.atlassian.com/v1/mcp"
      ]
    }
  },
  "skillListingBudgetFraction": 0.05
}
