{
  "permissions": {
    "allow": [
      "Bash(~/.claude/scripts/parallel_agent.py:*)",
      "Bash(~/.claude/scripts/git_ops.sh:*)",
      "Bash(~/.claude/scripts/label_sync.sh:*)",
      "Bash(~/.claude/scripts/linear_ops.sh:*)",
      "Bash(~/.claude/scripts/version_pin.sh:*)",
      "Bash(~/.claude/scripts/version_pin_hook.sh:*)",
      "Bash(~/.claude/scripts/pr_review.sh:*)",
      "Bash(~/.claude/scripts/branch_clean.sh:*)",
      "Bash(~/.claude/scripts/command_catalog.py:*)",
      "Bash(~/.claude/scripts/generate_commands_doc.py:*)",
      "Bash(~/.claude/scripts/guidance_hint.py:*)",
      "Bash(shellcheck:*)",
      "Bash(python3:*)",
      "Bash(pip3 install:*)",
      "Bash(pre-commit run:*)",
      "Bash(chmod:*)",
      "Bash(ls:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(glab issue:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:docs.github.com)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/guidance_hint.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/version_pin_hook.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/spec_review.sh --silent"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/lint_on_edit_hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'token-economy: lead with result; terse; surgical edits; one targeted question if ambiguous'"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.context7.com/mcp/oauth"
      ]
    },
    "linear": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ]
    },
    "atlassian": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.atlassian.com/v1/mcp"
      ]
    }
  }
}
