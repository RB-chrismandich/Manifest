{
  "_comment": [
    "Bootstrap merges this source into the target Claude settings.json; user scalar/model/permission choices are preserved.",
    "merge_runtime_settings.py seeds a non-forcing worker default only on Claude Code >=2.1.251, where explicit invocation/frontmatter pins take precedence.",
    "The Agent hook runs in native-default-only mode: diagnostics, never input rewriting. Managed and CLI agent definitions cannot be resolved safely by a filesystem scan.",
    "Unknown/older hosts receive no new worker default. Native serving, model availability and other configuration scopes remain unverified.",
    "Local merge receipts record hashes/status and rollback ownership; no prompts, credentials or settings values are exported.",
    "MCP registration remains separate in .claude.json; skillListingBudgetFraction stays at 0.05."
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/subagent_model_default.py --native-default-only"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/guidance_hint.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/block_cwd_delete.py"
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/constitution_hook.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/spec_review.sh --silent"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/lint_on_edit_hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'token-conserve: lead with result; terse; surgical edits; one targeted question if ambiguous'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/deploy_stamp_check.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(~/.claude/scripts/label_sync.sh:*)",
      "Bash(~/.claude/scripts/linear_ops.sh:*)",
      "Bash(~/.claude/scripts/pr_review.sh:*)",
      "Bash(~/.claude/scripts/branch_clean.sh:*)",
      "Bash(~/.claude/scripts/command_catalog.py:*)",
      "Bash(~/.claude/scripts/generate_commands_doc.py:*)",
      "Bash(~/.claude/scripts/guidance_hint.py:*)",
      "Bash(~/.claude/scripts/block_cwd_delete.py:*)",
      "Bash(~/.claude/scripts/subagent_model_default.py:*)",
      "Bash(~/.claude/scripts/subagent_breakdown.py:*)",
      "Bash(~/.claude/scripts/constitution_check.py:*)",
      "Bash(~/.claude/scripts/constitution_hook.py:*)",
      "Bash(shellcheck:*)",
      "Bash(python3:*)",
      "Bash(pip3 install:*)",
      "Bash(pre-commit run:*)",
      "Bash(chmod:*)",
      "Bash(ls:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(glab issue:*)",
      "Bash(~/.claude/scripts/deploy_stamp_check.sh:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:docs.github.com)"
    ]
  },
  "skillListingBudgetFraction": 0.05
}
