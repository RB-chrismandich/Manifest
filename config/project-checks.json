{
  "schema_version": 1,
  "checks": [
    {
      "id": "structure.compile-manifest-agent",
      "group": "structure",
      "category": "syntax",
      "argv": ["python3", "-m", "compileall", "-q", "src/manifest_agent"],
      "cwd": ".",
      "inputs": ["src/manifest_agent"],
      "dependencies": [],
      "timeout_seconds": 60,
      "selection": "project",
      "tool": "python3",
      "version": "runtime",
      "honors_status_contract": false
    },
    {
      "id": "lint.python",
      "group": "lint",
      "category": "lint",
      "argv": ["store:python-env/bin/ruff", "check", "--no-cache", "src", "tests/python"],
      "cwd": ".",
      "inputs": ["src", "tests/python"],
      "dependencies": ["config/toolchain.lock.json", "config/toolchain/uv.lock"],
      "timeout_seconds": 300,
      "selection": "project",
      "tool": "python-env",
      "version": "ruff=0.15.20",
      "honors_status_contract": false
    },
    {
      "id": "test.python",
      "group": "test",
      "category": "test",
      "argv": [
        "store:python-env/bin/pytest",
        "-q",
        "-c",
        "config/shared-checks-pytest.ini",
        "--rootdir=.",
        "tests/python/manifest_agent/test_candidate.py",
        "tests/python/manifest_agent/test_ci_context.py",
        "tests/python/manifest_agent/test_ci_context_cli.py",
        "tests/python/manifest_agent/test_shared_checks_slice_a.py",
        "tests/python/manifest_agent/test_shared_checks_review_regressions.py",
        "tests/python/manifest_agent/test_shared_check_workflow.py",
        "tests/python/manifest_agent/test_toolchain.py",
        "tests/python/manifest_agent/test_toolchain_attestation_workflow.py",
        "tests/python/manifest_agent/test_toolchain_cli.py",
        "tests/python/manifest_agent/test_toolchain_env.py",
        "tests/python/manifest_agent/test_toolchain_env_digest.py",
        "tests/python/manifest_agent/test_toolchain_materialize.py",
        "tests/python/manifest_agent/test_toolchain_npm_cache.py",
        "tests/python/manifest_agent/test_toolchain_path_prepend.py",
        "tests/python/manifest_agent/test_toolchain_provision.py",
        "tests/python/manifest_agent/test_toolchain_provision_hardening.py"
      ],
      "cwd": ".",
      "inputs": ["src", "tests/python", "plugins"],
      "dependencies": ["config/shared-checks-pytest.ini", "config/toolchain.lock.json", "config/toolchain/uv.lock"],
      "timeout_seconds": 1800,
      "selection": "project",
      "tool": "python-env",
      "version": "pytest=9.1.1",
      "honors_status_contract": false
    },
    {
      "id": "security.gitleaks",
      "group": "security",
      "category": "security",
      "argv": ["store:gitleaks/bin/gitleaks", "detect", "--source", ".", "--no-git", "--no-banner", "--redact", "--exit-code", "1"],
      "cwd": ".",
      "inputs": ["."],
      "dependencies": ["config/toolchain.lock.json"],
      "timeout_seconds": 300,
      "selection": "project",
      "tool": "gitleaks",
      "version": "8.30.1",
      "honors_status_contract": false
    },
    {
      "id": "package.fresh-checkout",
      "group": "package",
      "category": "package",
      "argv": ["python3", "tools/project_checks/package_archive.py", "--root", "."],
      "cwd": ".",
      "inputs": ["bootstrap.sh", "bootstrap", "configs", "plugins"],
      "dependencies": [],
      "timeout_seconds": 600,
      "selection": "project",
      "tool": "repository-script",
      "version": "repository",
      "honors_status_contract": true
    }
  ],
  "profiles": {
    "quick": ["structure.compile-manifest-agent", "lint.python"],
    "full": ["structure.compile-manifest-agent", "lint.python", "test.python", "security.gitleaks", "package.fresh-checkout"],
    "security": ["security.gitleaks"],
    "release": ["structure.compile-manifest-agent", "lint.python", "test.python", "security.gitleaks", "package.fresh-checkout"]
  },
  "debt_baseline": "config/debt-baseline.json",
  "preservation": "config/check-preservation.json",
  "toolchain_lock": "config/toolchain.lock.json"
}
