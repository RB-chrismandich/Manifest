{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Permission preset for Python monorepo projects - Zero-trust security model",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "// ============================================",
      "// Testing & Quality",
      "// ============================================",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(coverage:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(black:*)",
      "Bash(isort:*)",
      "Bash(pylint:*)",
      "Bash(flake8:*)",
      "Bash(bandit:*)",

      "// ============================================",
      "// Python & Package Management",
      "// ============================================",
      "Bash(python --version:*)",
      "Bash(python3 --version:*)",
      "Bash(poetry --version:*)",
      "Bash(poetry show:*)",
      "Bash(poetry check:*)",
      "Bash(poetry env info:*)",
      "Bash(pip list:*)",
      "Bash(pip show:*)",

      "// ============================================",
      "// Poetry Commands (read-only)",
      "// ============================================",
      "Bash(poetry run:*)",
      "Bash(poetry shell:*)",

      "// ============================================",
      "// Docker & Containers",
      "// ============================================",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",

      "// ============================================",
      "// Git Operations",
      "// ============================================",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git stash:*)",
      "Bash(git ls-tree:*)",

      "// ============================================",
      "// GitHub CLI (read + create PRs/issues)",
      "// ============================================",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr create:*)",

      "// ============================================",
      "// GitLab CLI (read + create MRs/issues)",
      "// ============================================",
      "Bash(glab issue list:*)",
      "Bash(glab issue view:*)",
      "Bash(glab issue create:*)",
      "Bash(glab issue note:*)",
      "Bash(glab mr list:*)",
      "Bash(glab mr view:*)",
      "Bash(glab mr create:*)",

      "// ============================================",
      "// File Operations (read-only)",
      "// ============================================",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",

      "// ============================================",
      "// Pre-commit Hooks",
      "// ============================================",
      "Bash(pre-commit:*)",

      "// ============================================",
      "// Monorepo Tools",
      "// ============================================",
      "Bash(nx:*)",
      "Bash(lerna:*)",
      "Bash(turborepo:*)",

      "// ============================================",
      "// Build Tools",
      "// ============================================",
      "Bash(make:*)",
      "Bash(invoke:*)",
      "Bash(task:*)",

      "// ============================================",
      "// Manifest Parallel Agent",
      "// ============================================",
      "Bash(~/.claude/scripts/parallel_agent.sh:*)",

      "// ============================================",
      "// Web Search & Fetch (for documentation)",
      "// ============================================",
      "WebSearch",
      "WebFetch(domain:python.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:python-poetry.org)",
      "WebFetch(domain:docs.pytest.org)",
      "WebFetch(domain:mypy-lang.org)",
      "WebFetch(domain:black.readthedocs.io)"
    ],

    "deny": [
      "// ============================================",
      "// DANGEROUS: System Administration",
      "// ============================================",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",

      "// ============================================",
      "// DANGEROUS: Package Management (system-wide)",
      "// ============================================",
      "Bash(pip install:*)",
      "Bash(pip uninstall:*)",
      "Bash(python -m pip install:*)",
      "Bash(python3 -m pip install:*)",
      "Bash(poetry install:*)",
      "Bash(poetry add:*)",
      "Bash(poetry remove:*)",
      "Bash(poetry update:*)",

      "// ============================================",
      "// DANGEROUS: Publishing",
      "// ============================================",
      "Bash(poetry publish:*)",
      "Bash(twine upload:*)",
      "Bash(python setup.py upload:*)",

      "// ============================================",
      "// DANGEROUS: Database Operations",
      "// ============================================",
      "Bash(dropdb:*)",
      "Bash(psql -c DROP:*)",
      "Bash(mysql -e DROP:*)",

      "// ============================================",
      "// DANGEROUS: Deployment",
      "// ============================================",
      "Bash(kubectl:*)",
      "Bash(heroku:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",

      "// ============================================",
      "// DANGEROUS: Docker Registry",
      "// ============================================",
      "Bash(docker push:*)",
      "Bash(docker rmi:*)"
    ]
  },

  "notes": [
    "This preset is for DEVELOPMENT environments only.",
    "Package installation (poetry install, pip install) is blocked - use in virtual environments manually.",
    "For CI/CD pipelines, create a separate preset allowing package installation.",
    "Review and customize for your specific monorepo structure.",
    "Add workspace-specific commands as needed."
  ]
}
