{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Permission preset for Express.js/Node.js API applications - Zero-trust security model",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "// ============================================",
      "// Testing & Quality",
      "// ============================================",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npx jest:*)",
      "Bash(npx vitest:*)",
      "Bash(npx mocha:*)",
      "Bash(npm run lint:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",

      "// ============================================",
      "// Node.js & npm",
      "// ============================================",
      "Bash(node --version:*)",
      "Bash(npm --version:*)",
      "Bash(npm list:*)",
      "Bash(npm outdated:*)",
      "Bash(npm audit:*)",

      "// ============================================",
      "// Development",
      "// ============================================",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run start:*)",
      "Bash(npx nodemon:*)",

      "// ============================================",
      "// Database Migrations (Sequelize, Knex, Prisma)",
      "// ============================================",
      "Bash(npx sequelize-cli db:migrate:*)",
      "Bash(npx sequelize-cli db:migrate:status:*)",
      "Bash(npx knex migrate:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(npx prisma db:*)",
      "Bash(npx typeorm migration:*)",

      "// ============================================",
      "// Docker & Containers",
      "// ============================================",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",

      "// ============================================",
      "// Git Operations",
      "// ============================================",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git stash:*)",
      "Bash(git ls-tree:*)",

      "// ============================================",
      "// GitHub CLI (read + create PRs/issues)",
      "// ============================================",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr create:*)",

      "// ============================================",
      "// GitLab CLI (read + create MRs/issues)",
      "// ============================================",
      "Bash(glab issue list:*)",
      "Bash(glab issue view:*)",
      "Bash(glab issue create:*)",
      "Bash(glab issue note:*)",
      "Bash(glab mr list:*)",
      "Bash(glab mr view:*)",
      "Bash(glab mr create:*)",

      "// ============================================",
      "// File Operations (read-only)",
      "// ============================================",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",

      "// ============================================",
      "// Manifest Parallel Agent",
      "// ============================================",
      "Bash(~/.claude/scripts/parallel_agent.sh:*)",

      "// ============================================",
      "// Web Search & Fetch (for documentation)",
      "// ============================================",
      "WebSearch",
      "WebFetch(domain:expressjs.com)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:sequelize.org)",
      "WebFetch(domain:www.prisma.io)",
      "WebFetch(domain:typeorm.io)",
      "WebFetch(domain:jestjs.io)",
      "WebFetch(domain:vitest.dev)"
    ],

    "deny": [
      "// ============================================",
      "// DANGEROUS: System Administration",
      "// ============================================",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",

      "// ============================================",
      "// DANGEROUS: Package Management",
      "// ============================================",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(npm publish:*)",
      "Bash(yarn install:*)",
      "Bash(yarn add:*)",
      "Bash(pnpm install:*)",

      "// ============================================",
      "// DANGEROUS: Database Operations",
      "// ============================================",
      "Bash(npx sequelize-cli db:drop:*)",
      "Bash(npx sequelize-cli db:seed:*)",
      "Bash(npx knex migrate:rollback:*)",
      "Bash(npx prisma db push:*)",
      "Bash(npx prisma db reset:*)",
      "Bash(dropdb:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",

      "// ============================================",
      "// DANGEROUS: Production Commands",
      "// ============================================",
      "Bash(pm2:*)",
      "Bash(forever:*)",
      "Bash(nodemon --prod:*)",

      "// ============================================",
      "// DANGEROUS: Deployment",
      "// ============================================",
      "Bash(kubectl:*)",
      "Bash(heroku:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(vercel:*)",
      "Bash(netlify:*)",

      "// ============================================",
      "// DANGEROUS: Docker Registry",
      "// ============================================",
      "Bash(docker push:*)",
      "Bash(docker rmi:*)"
    ]
  },

  "notes": [
    "This preset is for DEVELOPMENT environments only.",
    "For CI/CD pipelines, create a separate preset with deployment permissions.",
    "npm install is blocked - use npm ci in CI environments or allow explicitly for dev.",
    "Review and customize for your specific project needs."
  ]
}
