{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Permission preset for Django web applications - Zero-trust security model",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "// ============================================",
      "// Testing & Quality",
      "// ============================================",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python manage.py test:*)",
      "Bash(coverage:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(black:*)",
      "Bash(isort:*)",

      "// ============================================",
      "// Django Management Commands",
      "// ============================================",
      "Bash(python manage.py check:*)",
      "Bash(python manage.py makemigrations:*)",
      "Bash(python manage.py migrate:*)",
      "Bash(python manage.py showmigrations:*)",
      "Bash(python manage.py sqlmigrate:*)",
      "Bash(python manage.py shell:*)",
      "Bash(python manage.py dbshell:*)",

      "// ============================================",
      "// Development Server (local only)",
      "// ============================================",
      "Bash(python manage.py runserver:*)",

      "// ============================================",
      "// Docker & Containers",
      "// ============================================",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",

      "// ============================================",
      "// Git Operations",
      "// ============================================",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git stash:*)",
      "Bash(git ls-tree:*)",

      "// ============================================",
      "// GitHub CLI (read + create PRs/issues)",
      "// ============================================",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr create:*)",

      "// ============================================",
      "// GitLab CLI (read + create MRs/issues)",
      "// ============================================",
      "Bash(glab issue list:*)",
      "Bash(glab issue view:*)",
      "Bash(glab issue create:*)",
      "Bash(glab issue note:*)",
      "Bash(glab mr list:*)",
      "Bash(glab mr view:*)",
      "Bash(glab mr create:*)",

      "// ============================================",
      "// File Operations (read-only)",
      "// ============================================",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",

      "// ============================================",
      "// Python & Dependencies",
      "// ============================================",
      "Bash(python --version:*)",
      "Bash(python -m pip list:*)",
      "Bash(pip list:*)",
      "Bash(pip show:*)",

      "// ============================================",
      "// Pre-commit Hooks",
      "// ============================================",
      "Bash(pre-commit:*)",

      "// ============================================",
      "// Manifest Parallel Agent",
      "// ============================================",
      "Bash(~/.claude/scripts/parallel_agent.py:*)",

      "// ============================================",
      "// Web Search & Fetch (for documentation)",
      "// ============================================",
      "WebSearch",
      "WebFetch(domain:docs.djangoproject.com)",
      "WebFetch(domain:www.django-rest-framework.org)",
      "WebFetch(domain:docs.celeryq.dev)",
      "WebFetch(domain:www.postgresql.org)"
    ],

    "deny": [
      "// ============================================",
      "// DANGEROUS: System Administration",
      "// ============================================",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",

      "// ============================================",
      "// DANGEROUS: Django Admin Commands",
      "// ============================================",
      "Bash(django-admin:*)",
      "Bash(python manage.py createsuperuser:*)",
      "Bash(python manage.py changepassword:*)",
      "Bash(python manage.py flush:*)",
      "Bash(python manage.py loaddata:*)",

      "// ============================================",
      "// DANGEROUS: Package Management (system-wide)",
      "// ============================================",
      "Bash(pip install:*)",
      "Bash(pip uninstall:*)",
      "Bash(python -m pip install:*)",

      "// ============================================",
      "// DANGEROUS: Database Operations",
      "// ============================================",
      "Bash(dropdb:*)",
      "Bash(pg_dump:*)",
      "Bash(psql:*)",

      "// ============================================",
      "// DANGEROUS: Production Commands",
      "// ============================================",
      "Bash(python manage.py collectstatic:*)",
      "Bash(gunicorn:*)",
      "Bash(uwsgi:*)",

      "// ============================================",
      "// DANGEROUS: Deployment",
      "// ============================================",
      "Bash(kubectl:*)",
      "Bash(heroku:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)"
    ]
  },

  "notes": [
    "This preset is for DEVELOPMENT environments only.",
    "For production deployments, create a separate preset with stricter controls.",
    "Review and customize for your specific project needs.",
    "Add project-specific dangerous commands to the deny list."
  ]
}
