{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Permission preset for Go microservices architecture - Zero-trust security model",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "// ============================================",
      "// Testing & Quality",
      "// ============================================",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go fmt:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint:*)",
      "Bash(staticcheck:*)",
      "Bash(go test -race:*)",
      "Bash(go test -cover:*)",

      "// ============================================",
      "// Go Build & Development",
      "// ============================================",
      "Bash(go build:*)",
      "Bash(go run:*)",
      "Bash(go mod:*)",
      "Bash(go get:*)",
      "Bash(go list:*)",
      "Bash(go version:*)",
      "Bash(go env:*)",

      "// ============================================",
      "// Protobuf (for gRPC services)",
      "// ============================================",
      "Bash(buf:*)",
      "Bash(protoc:*)",

      "// ============================================",
      "// Database Migrations (golang-migrate)",
      "// ============================================",
      "Bash(migrate:*)",
      "Bash(go run migrations/*.go:*)",

      "// ============================================",
      "// Docker & Containers",
      "// ============================================",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Bash(docker build:*)",
      "Bash(docker exec:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker info:*)",
      "Bash(docker config:*)",

      "// ============================================",
      "// Kubernetes (read-only)",
      "// ============================================",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl config:*)",
      "Bash(kubectl version:*)",

      "// ============================================",
      "// Git Operations",
      "// ============================================",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git stash:*)",
      "Bash(git ls-tree:*)",

      "// ============================================",
      "// GitHub CLI (read + create PRs/issues)",
      "// ============================================",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr create:*)",

      "// ============================================",
      "// GitLab CLI (read + create MRs/issues)",
      "// ============================================",
      "Bash(glab issue list:*)",
      "Bash(glab issue view:*)",
      "Bash(glab issue create:*)",
      "Bash(glab issue note:*)",
      "Bash(glab mr list:*)",
      "Bash(glab mr view:*)",
      "Bash(glab mr create:*)",

      "// ============================================",
      "// File Operations (read-only)",
      "// ============================================",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",

      "// ============================================",
      "// Make & Task Runners",
      "// ============================================",
      "Bash(make:*)",
      "Bash(task:*)",

      "// ============================================",
      "// Manifest Parallel Agent",
      "// ============================================",
      "Bash(~/.claude/scripts/parallel_agent.sh:*)",

      "// ============================================",
      "// Web Search & Fetch (for documentation)",
      "// ============================================",
      "WebSearch",
      "WebFetch(domain:go.dev)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:grpc.io)",
      "WebFetch(domain:buf.build)",
      "WebFetch(domain:kubernetes.io)"
    ],

    "deny": [
      "// ============================================",
      "// DANGEROUS: System Administration",
      "// ============================================",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",

      "// ============================================",
      "// DANGEROUS: Go Module Management (production)",
      "// ============================================",
      "Bash(go get -u:*)",
      "Bash(go mod tidy:*)",
      "Bash(go clean:*)",

      "// ============================================",
      "// DANGEROUS: Database Operations",
      "// ============================================",
      "Bash(migrate down:*)",
      "Bash(migrate drop:*)",
      "Bash(dropdb:*)",
      "Bash(psql -c DROP:*)",

      "// ============================================",
      "// DANGEROUS: Kubernetes Write Operations",
      "// ============================================",
      "Bash(kubectl apply:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl rollout:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl exec:*)",

      "// ============================================",
      "// DANGEROUS: Docker Registry",
      "// ============================================",
      "Bash(docker push:*)",
      "Bash(docker rmi:*)",
      "Bash(docker tag:*)",
      "Bash(docker login:*)",

      "// ============================================",
      "// DANGEROUS: Cloud Providers",
      "// ============================================",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(az:*)",
      "Bash(terraform:*)",
      "Bash(pulumi:*)",

      "// ============================================",
      "// DANGEROUS: Service Mesh",
      "// ============================================",
      "Bash(istioctl:*)",
      "Bash(linkerd:*)"
    ]
  },

  "notes": [
    "This preset is for DEVELOPMENT and READ-ONLY Kubernetes access.",
    "For CI/CD pipelines, create a separate preset with deployment permissions.",
    "kubectl write operations are blocked - use separate preset for deployments.",
    "docker push is blocked - enable only in CI/CD environments.",
    "Review and customize for your specific project needs."
  ]
}
