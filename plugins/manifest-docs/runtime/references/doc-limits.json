{
  "classify": [
    {
      "glob": "README.md",
      "type": "readme_root"
    },
    {
      "glob": "**/docs/README.md",
      "type": "hub"
    },
    {
      "glob": "docs/README.md",
      "type": "hub"
    },
    {
      "glob": "**/index.md",
      "type": "hub"
    },
    {
      "glob": "**/*DIAGRAM*.md",
      "type": "diagram"
    },
    {
      "glob": "**/*ARCHITECTURE*.md",
      "type": "explanation"
    },
    {
      "glob": "**/GETTING_STARTED.md",
      "type": "tutorial"
    },
    {
      "glob": "**/TUTORIAL*.md",
      "type": "tutorial"
    },
    {
      "glob": "**/tutorials/**/*.md",
      "type": "tutorial"
    },
    {
      "glob": "**/how-to/**/*.md",
      "type": "howto"
    },
    {
      "glob": "**/HOWTO*.md",
      "type": "howto"
    },
    {
      "glob": "**/TROUBLESHOOTING.md",
      "type": "howto"
    },
    {
      "glob": "**/CONFIGURATION.md",
      "type": "reference"
    },
    {
      "glob": "**/*REFERENCE*.md",
      "type": "reference"
    },
    {
      "glob": "**/reference/**/*.md",
      "type": "reference"
    },
    {
      "glob": "**/COMMANDS.md",
      "type": "reference"
    },
    {
      "glob": "**/explanation/**/*.md",
      "type": "explanation"
    }
  ],
  "defaults": {
    "max_lines": 250,
    "warn_at": 0.8
  },
  "exempt": {
    "globs": [
      "CHANGELOG.md",
      "**/CHANGELOG.md",
      "**/node_modules/**",
      "**/.venv/**",
      "**/vendor/**",
      "**/site-packages/**",
      "**/.remember/**",
      "**/specs/**",
      "**/plans/**",
      "**/superpowers/**",
      "**/baselines/**",
      "**/decisions/**",
      "**/*_REPORT.md",
      "**/templates/**"
    ],
    "markers": [
      "<!-- generated",
      "DO NOT EDIT",
      "AUTO-GENERATED",
      "Generated by"
    ]
  },
  "fluff": {
    "phrases": [
      "comprehensive",
      "powerful",
      "seamless",
      "seamlessly",
      "robust",
      "cutting-edge",
      "state-of-the-art",
      "best-in-class",
      "blazing fast",
      "lightning fast",
      "world-class",
      "rich set of",
      "wide range of",
      "full-featured",
      "simply",
      "it's easy to",
      "it is easy to",
      "effortlessly",
      "just run",
      "you just need",
      "in this document",
      "in this section, we will",
      "this guide will walk you through",
      "let's dive",
      "as mentioned above",
      "as we can see",
      "it is important to note",
      "it should be noted",
      "please note that",
      "note that the",
      "needless to say",
      "of course",
      "obviously",
      "basically"
    ],
    "structure": {
      "hrule_floor": 4,
      "max_hrules_per_100_lines": 3,
      "toc_below_lines": 100
    }
  },
  "overrides": {
    "limit_marker": "doc-limit:",
    "type_marker": "doc-type:"
  },
  "types": {
    "diagram": {
      "max_diagrams": 4,
      "max_lines": 300,
      "purpose": "Rendered visuals plus captions. Additional cap: max_diagrams per page."
    },
    "explanation": {
      "max_lines": 250,
      "purpose": "Why the system is shaped this way. Background and trade-offs, no steps."
    },
    "howto": {
      "max_lines": 200,
      "purpose": "One goal, ordered steps, one working example. Not a survey of options."
    },
    "hub": {
      "max_lines": 120,
      "purpose": "Navigation only: what lives here and one line per child page. A hub that explains things is an explanation page wearing a hub's name."
    },
    "readme_root": {
      "max_lines": 200,
      "purpose": "What this is, how to run it, where to go next. Everything a reader needs past the first ten minutes belongs in docs/ and is linked, not inlined."
    },
    "reference": {
      "max_lines": 400,
      "purpose": "Lookup surface (flags, keys, endpoints, schema). Highest cap because readers arrive via search and leave, but split by subject once over."
    },
    "tutorial": {
      "max_lines": 200,
      "purpose": "One learner, one lesson, start to finish. Two lessons is two pages."
    }
  }
}
