{
  "actions": {
    "always_safe": [
      "mark_duplicate",
      "add_comment",
      "link_related",
      "add_label"
    ],
    "never_auto": [
      "delete_issue",
      "merge_descriptions",
      "create_issue",
      "modify_description"
    ],
    "requires_confirmation": [
      "close_issue",
      "update_priority",
      "update_status",
      "remove_label"
    ]
  },
  "batch": {
    "cache_ttl_seconds": 604800,
    "chunk_size": 15,
    "max_concurrent": 3
  },
  "consensus": {
    "high_threshold": 0.8,
    "medium_threshold": 0.5,
    "timeout_seconds": 300,
    "use_for_duplicates": true,
    "use_for_priority": true
  },
  "duplicate_detection": {
    "description_overlap_high": 0.7,
    "description_overlap_medium": 0.5,
    "same_scope_boost": 0.05,
    "shared_labels_boost": 0.05,
    "title_similarity_high": 0.8,
    "title_similarity_medium": 0.65
  },
  "output": {
    "confidence_thresholds": {
      "high": 0.85,
      "low": 0.5,
      "medium": 0.7
    },
    "include_audit_trail": true,
    "report_format": "markdown"
  },
  "priority": {
    "formula": {
      "impact_weight": 3,
      "readiness_weight": 2,
      "risk_weight": -1,
      "urgency_weight": 2
    },
    "labels": {
      "0": "None",
      "1": "Urgent",
      "2": "High",
      "3": "Medium",
      "4": "Low"
    },
    "mapping": {
      "high": 22,
      "low": 10,
      "medium": 16,
      "none": 0,
      "urgent": 28
    }
  },
  "staleness": {
    "blocker_inactive_days": 180,
    "deprecated_components": [
      {
        "deprecated_date": "2025-11-01",
        "name": "legacy-auth",
        "replacement": "oauth2-service"
      },
      {
        "deprecated_date": "2025-09-15",
        "name": "old-api-v1",
        "replacement": "api-v2"
      }
    ],
    "file_missing_threshold": 0.5,
    "inactivity_days": 90
  }
}
