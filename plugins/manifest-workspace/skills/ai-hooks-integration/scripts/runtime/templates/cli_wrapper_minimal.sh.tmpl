#!/bin/bash
# CLI Wrapper for {cli_name} (minimal)
# Generated by ai-hooks-integration
# Original: {original_path}

ORIGINAL="{original_path}"
PRE_HOOK="{pre_hook}"
POST_HOOK="{post_hook}"
# shellcheck disable=SC1083
HOOK_TIMEOUT={hook_timeout}

if [[ -n "$PRE_HOOK" ]]; then
    PRE_STATUS=0
    python3 -c 'import json,os,shlex,signal,subprocess,sys
payload=json.dumps({{"cli":sys.argv[2],"args":sys.argv[4:],"cwd":os.getcwd(),"phase":"pre"}})
command=sys.argv[3]+" --cli "+shlex.quote(sys.argv[2])+" --phase pre -- "+" ".join(map(shlex.quote,sys.argv[4:]))
proc=None
try:
    proc=subprocess.Popen(command,shell=True,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,start_new_session=True)
    out,_=proc.communicate(timeout=float(sys.argv[1]))
except subprocess.TimeoutExpired:
    try: os.killpg(proc.pid,signal.SIGKILL)
    except ProcessLookupError: pass
    proc.communicate(); sys.exit(124)
except FileNotFoundError: sys.exit(127)
except Exception: sys.exit(126)
if proc.returncode: sys.exit(proc.returncode if proc.returncode > 0 else 128-proc.returncode)
try:
    text=out.decode("utf-8")
    if not text.strip(" \t\r\n"): sys.exit(0)
    decoder=json.JSONDecoder(parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))
    start=len(text)-len(text.lstrip(" \t\r\n")); response,end=decoder.raw_decode(text,start)
    if text[end:].strip(" \t\r\n") or not isinstance(response,dict): sys.exit(1)
    if response.get("decision")=="deny": sys.exit(1)
except Exception: sys.exit(1)' "$HOOK_TIMEOUT" "{cli_name}" "$PRE_HOOK" "$@" || PRE_STATUS=$?
    if [[ "$PRE_STATUS" -ne 0 ]]; then
        echo "Error: pre-hook failed (exit $PRE_STATUS)" >&2
        exit "$PRE_STATUS"
    fi
fi

EXIT_CODE=0
"$ORIGINAL" "$@" || EXIT_CODE=$?

if [[ -n "$POST_HOOK" ]]; then
    python3 -c 'import json,os,shlex,signal,subprocess,sys
payload=json.dumps({{"cli":sys.argv[2],"args":sys.argv[5:],"cwd":os.getcwd(),"exit_code":int(sys.argv[3]),"phase":"post"}})
command=sys.argv[4]+" --cli "+shlex.quote(sys.argv[2])+" --phase post --exit-code "+shlex.quote(sys.argv[3])+" -- "+" ".join(map(shlex.quote,sys.argv[5:]))
proc=None
try:
    proc=subprocess.Popen(command,shell=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
    proc.communicate(timeout=float(sys.argv[1]))
except subprocess.TimeoutExpired:
    try: os.killpg(proc.pid,signal.SIGKILL)
    except ProcessLookupError: pass
    proc.communicate()
except Exception: pass' "$HOOK_TIMEOUT" "{cli_name}" "$EXIT_CODE" "$POST_HOOK" "$@" || true
fi
exit "$EXIT_CODE"
