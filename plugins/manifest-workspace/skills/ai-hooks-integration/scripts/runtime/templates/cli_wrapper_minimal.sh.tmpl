ORIGINAL="{original_path}"
PRE_HOOK="{pre_hook}"
POST_HOOK="{post_hook}"
# shellcheck disable=SC1083
HOOK_TIMEOUT={hook_timeout}
HOOK_RUNNER_PID=""
HOOK_OUTPUT_FILE=""
HOOK_PID_FILE=""
HOOK_SIGNAL=0
# shellcheck disable=SC1054
handle_hook_signal() {{
local signum="$1"
local hook_group=""
if [[ "$HOOK_SIGNAL" -eq 0 ]]; then
    HOOK_SIGNAL="$signum"
fi
signum="$HOOK_SIGNAL"
trap '' INT TERM
if [[ -z "$HOOK_RUNNER_PID" ]]; then
    return
fi
if [[ -n "$HOOK_PID_FILE" && -s "$HOOK_PID_FILE" ]]; then
    hook_group=$(< "$HOOK_PID_FILE")
    if [[ "$hook_group" =~ ^[0-9]+$ ]]; then
        : > "$HOOK_PID_FILE.owner" 2> /dev/null || true
        kill -s "$signum" -- "-$hook_group" 2> /dev/null || true
        kill -s KILL -- "-$hook_group" 2> /dev/null || true
    fi
fi
kill -s "$signum" "$HOOK_RUNNER_PID" 2> /dev/null || true
wait "$HOOK_RUNNER_PID" 2> /dev/null || true
if [[ -n "$HOOK_OUTPUT_FILE" ]]; then
    rm -f "$HOOK_OUTPUT_FILE" || true
fi
if [[ -n "$HOOK_PID_FILE" ]]; then
    rm -f "$HOOK_PID_FILE" "$HOOK_PID_FILE.owner" || true
fi
exit $((128 + signum))
}}

if [[ -n "$PRE_HOOK" ]]; then
    PRE_STATUS=0
    HOOK_SIGNAL=0
    HOOK_RUNNER_PID=""
    HOOK_OUTPUT_FILE=""
    HOOK_PID_FILE=""
    trap 'handle_hook_signal 2' INT
    trap 'handle_hook_signal 15' TERM
    HOOK_PID_FILE=$(mktemp)
    exec 3<&0
    python3 -c 'import json,os,shlex,signal,subprocess,sys
payload=json.dumps({{"cli":sys.argv[2],"args":sys.argv[5:],"cwd":os.getcwd(),"phase":"pre"}})
command=sys.argv[3]+" --cli "+shlex.quote(sys.argv[2])+" --phase pre -- "+" ".join(map(shlex.quote,sys.argv[5:]))
proc=None
pending_signal=None
previous_handlers={{}}
class HookCancelled(Exception):
    def __init__(self,signum): self.signum=signum
def kill_group(signum):
    if proc is not None:
        try: os.killpg(proc.pid,signum)
        except ProcessLookupError: pass
def handle_signal(signum,frame):
    global pending_signal
    if pending_signal is None: pending_signal=signum
for signum in (signal.SIGINT,signal.SIGTERM):
    previous_handlers[signum]=signal.signal(signum,handle_signal)
try:
    if pending_signal is not None: raise HookCancelled(pending_signal)
    proc=subprocess.Popen(command,shell=True,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,start_new_session=True)
    with open(sys.argv[4],"w",encoding="ascii") as pid_file: pid_file.write(str(proc.pid))
    if pending_signal is not None: raise HookCancelled(pending_signal)
    out,_=proc.communicate(timeout=float(sys.argv[1]))
    if pending_signal is not None: raise HookCancelled(pending_signal)
except subprocess.TimeoutExpired:
    for signum in previous_handlers: signal.signal(signum,signal.SIG_IGN)
    kill_group(signal.SIGKILL)
    proc.communicate(); sys.exit(124)
except HookCancelled as cancelled:
    for signum in previous_handlers: signal.signal(signum,signal.SIG_IGN)
    if proc is not None:
        if not os.path.exists(sys.argv[4]+".owner"):
            kill_group(cancelled.signum)
            kill_group(signal.SIGKILL)
        proc.communicate()
    sys.exit(128+cancelled.signum)
except FileNotFoundError:
    if pending_signal is not None: sys.exit(128+pending_signal)
    sys.exit(127)
except Exception:
    for signum in previous_handlers: signal.signal(signum,signal.SIG_IGN)
    if proc is not None:
        kill_group(signal.SIGKILL)
        proc.communicate()
    if pending_signal is not None: sys.exit(128+pending_signal)
    sys.exit(126)
finally:
    for signum,previous in previous_handlers.items(): signal.signal(signum,previous)
if proc.returncode: sys.exit(proc.returncode if proc.returncode > 0 else 128-proc.returncode)
try:
    text=out.decode("utf-8")
    if not text.strip(" \t\r\n"): sys.exit(0)
    decoder=json.JSONDecoder(parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))
    start=len(text)-len(text.lstrip(" \t\r\n")); response,end=decoder.raw_decode(text,start)
    if text[end:].strip(" \t\r\n") or not isinstance(response,dict): sys.exit(1)
    if response.get("decision")=="deny": sys.exit(1)
except Exception: sys.exit(1)' "$HOOK_TIMEOUT" "{cli_name}" "$PRE_HOOK" "$HOOK_PID_FILE" "$@" 0<&3 3<&- &
    HOOK_RUNNER_PID=$!
    exec 3<&-
    if [[ "$HOOK_SIGNAL" -ne 0 ]]; then
        handle_hook_signal "$HOOK_SIGNAL"
    fi
    wait "$HOOK_RUNNER_PID" || PRE_STATUS=$?
    rm -f "$HOOK_PID_FILE" "$HOOK_PID_FILE.owner" || true
    HOOK_PID_FILE=""
    HOOK_RUNNER_PID=""
    trap - INT TERM
    if [[ "$HOOK_SIGNAL" -ne 0 ]]; then
        exit $((128 + HOOK_SIGNAL))
    fi
    if [[ "$PRE_STATUS" -ne 0 ]]; then
        echo "Error: pre-hook failed (exit $PRE_STATUS)" >&2
        exit "$PRE_STATUS"
    fi
fi

EXIT_CODE=0
"$ORIGINAL" "$@" || EXIT_CODE=$?

if [[ -n "$POST_HOOK" ]]; then
    HOOK_SIGNAL=0
    HOOK_RUNNER_PID=""
    HOOK_OUTPUT_FILE=""
    HOOK_PID_FILE=""
    trap 'handle_hook_signal 2' INT
    trap 'handle_hook_signal 15' TERM
    HOOK_PID_FILE=$(mktemp)
    exec 3<&0
    python3 -c 'import json,os,shlex,signal,subprocess,sys
payload=json.dumps({{"cli":sys.argv[2],"args":sys.argv[6:],"cwd":os.getcwd(),"exit_code":int(sys.argv[3]),"phase":"post"}})
command=sys.argv[4]+" --cli "+shlex.quote(sys.argv[2])+" --phase post --exit-code "+shlex.quote(sys.argv[3])+" -- "+" ".join(map(shlex.quote,sys.argv[6:]))
proc=None
pending_signal=None
previous_handlers={{}}
class HookCancelled(Exception):
    def __init__(self,signum): self.signum=signum
def kill_group(signum):
    if proc is not None:
        try: os.killpg(proc.pid,signum)
        except ProcessLookupError: pass
def handle_signal(signum,frame):
    global pending_signal
    if pending_signal is None: pending_signal=signum
for signum in (signal.SIGINT,signal.SIGTERM):
    previous_handlers[signum]=signal.signal(signum,handle_signal)
try:
    if pending_signal is not None: raise HookCancelled(pending_signal)
    proc=subprocess.Popen(command,shell=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
    with open(sys.argv[5],"w",encoding="ascii") as pid_file: pid_file.write(str(proc.pid))
    if pending_signal is not None: raise HookCancelled(pending_signal)
    proc.communicate(timeout=float(sys.argv[1]))
    if pending_signal is not None: raise HookCancelled(pending_signal)
except subprocess.TimeoutExpired:
    for signum in previous_handlers: signal.signal(signum,signal.SIG_IGN)
    kill_group(signal.SIGKILL)
    proc.communicate()
except HookCancelled as cancelled:
    for signum in previous_handlers: signal.signal(signum,signal.SIG_IGN)
    if proc is not None:
        if not os.path.exists(sys.argv[5]+".owner"):
            kill_group(cancelled.signum)
            kill_group(signal.SIGKILL)
        proc.communicate()
    sys.exit(128+cancelled.signum)
except Exception:
    for signum in previous_handlers: signal.signal(signum,signal.SIG_IGN)
    if proc is not None:
        kill_group(signal.SIGKILL)
        proc.communicate()
    if pending_signal is not None: sys.exit(128+pending_signal)
finally:
    for signum,previous in previous_handlers.items(): signal.signal(signum,previous)' "$HOOK_TIMEOUT" "{cli_name}" "$EXIT_CODE" "$POST_HOOK" "$HOOK_PID_FILE" "$@" 0<&3 3<&- &
    HOOK_RUNNER_PID=$!
    exec 3<&-
    if [[ "$HOOK_SIGNAL" -ne 0 ]]; then
        handle_hook_signal "$HOOK_SIGNAL"
    fi
    wait "$HOOK_RUNNER_PID" || true
    rm -f "$HOOK_PID_FILE" "$HOOK_PID_FILE.owner" || true
    HOOK_PID_FILE=""
    HOOK_RUNNER_PID=""
    trap - INT TERM
    if [[ "$HOOK_SIGNAL" -ne 0 ]]; then
        exit $((128 + HOOK_SIGNAL))
    fi
fi
exit "$EXIT_CODE"
