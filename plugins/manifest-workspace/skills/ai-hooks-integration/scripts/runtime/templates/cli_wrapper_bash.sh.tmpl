#!/bin/bash
# CLI Wrapper for {cli_name}
# Generated by ai-hooks-integration
# Original: {original_path}
#
# Status contract:
#   - pre-hook process exits nonzero -> wrapper exits with that exact status;
#     the CLI and post-hook do not run (timeout -> 124, missing hook -> 127).
#   - pre-hook prints {{"decision": "deny"}} -> wrapper exits 1.
#   - pre-hook prints output that is not a JSON object -> wrapper exits 1.
#   - otherwise the CLI runs once; the post-hook is informational and the
#     wrapper always exits with the CLI's own status.

set -euo pipefail

ORIGINAL="{original_path}"
PRE_HOOK="{pre_hook}"
POST_HOOK="{post_hook}"
# shellcheck disable=SC1083
HOOK_TIMEOUT={hook_timeout}

# Run pre-hook (blocks execution by exiting non-zero or denying)
if [[ -n "$PRE_HOOK" ]]; then
    # Send args as JSON to pre-hook stdin
    ARGS_JSON=$(printf '%s\n' "$@" | jq -R -s -c 'split("\n") | .[:-1]')
    PRE_INPUT=$(jq -n \
        --arg cli "{cli_name}" \
        --argjson args "$ARGS_JSON" \
        --arg cwd "$PWD" \
        '{{cli: $cli, args: $args, cwd: $cwd, phase: "pre"}}')

    PRE_STATUS=0
    PRE_RESULT=$(python3 -c 'import json,os,signal,subprocess,sys
process=None
try:
    process=subprocess.Popen(sys.argv[2],shell=True,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE,start_new_session=True)
    stdout,stderr=process.communicate(sys.stdin.buffer.read(),timeout=float(sys.argv[1]))
except subprocess.TimeoutExpired:
    try: os.killpg(process.pid,signal.SIGKILL)
    except ProcessLookupError: pass
    process.communicate()
    print("Error: pre-hook timed out",file=sys.stderr); sys.exit(124)
except Exception:
    print("Error: pre-hook could not run",file=sys.stderr); sys.exit(126)
if process.returncode: sys.exit(process.returncode if process.returncode > 0 else 128 - process.returncode)
try:
    text=stdout.decode("utf-8")
    if not text.strip(" \t\r\n"): print("allow"); sys.exit(0)
    decoder=json.JSONDecoder(parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))
    start=len(text)-len(text.lstrip(" \t\r\n")); result,end=decoder.raw_decode(text,start)
    if text[end:].strip(" \t\r\n") or not isinstance(result,dict): raise ValueError
    print("deny" if result.get("decision")=="deny" else "allow")
except Exception:
    print("Error: pre-hook returned malformed output",file=sys.stderr); sys.exit(1)' "$HOOK_TIMEOUT" "$PRE_HOOK" <<< "$PRE_INPUT") || PRE_STATUS=$?
    if [[ "$PRE_STATUS" -ne 0 ]]; then
        echo "Error: pre-hook failed (exit $PRE_STATUS)" >&2
        exit "$PRE_STATUS"
    fi

    if [[ "$PRE_RESULT" == "deny" ]]; then
        echo "Error: Blocked by pre-hook" >&2
        exit 1
    fi
fi

# Run original CLI exactly once and keep its status
EXIT_CODE=0
"$ORIGINAL" "$@" || EXIT_CODE=$?

# Run post-hook (informational, never changes the exit status)
if [[ -n "$POST_HOOK" ]]; then
    # shellcheck disable=SC1054
    {{
    ARGS_JSON=$(printf '%s\n' "$@" | jq -R -s -c 'split("\n") | .[:-1]')
    POST_INPUT=$(jq -n \
        --arg cli "{cli_name}" \
        --argjson args "$ARGS_JSON" \
        --arg cwd "$PWD" \
        --argjson exit_code "$EXIT_CODE" \
        '{{cli: $cli, args: $args, cwd: $cwd, exit_code: $exit_code, phase: "post"}}')
    python3 -c 'import os,signal,subprocess,sys
process=None
try:
    process=subprocess.Popen(sys.argv[2],shell=True,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE,start_new_session=True)
    stdout,stderr=process.communicate(sys.stdin.buffer.read(),timeout=float(sys.argv[1]))
except subprocess.TimeoutExpired:
    try: os.killpg(process.pid,signal.SIGKILL)
    except ProcessLookupError: pass
    process.communicate()
    print("Hook warning: post-hook timed out",file=sys.stderr); sys.exit(124)
except Exception:
    print("Hook warning: post-hook could not run",file=sys.stderr); sys.exit(126)
sys.stdout.buffer.write(stdout); sys.exit(process.returncode)' "$HOOK_TIMEOUT" "$POST_HOOK" <<< "$POST_INPUT"
    }} || true
fi

exit "$EXIT_CODE"
