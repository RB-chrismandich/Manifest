#!/usr/bin/env python3
# CLI Wrapper for {cli_name}
# Generated by ai-hooks-integration
# Original: {original_path}
#
# Status contract:
#   - pre-hook process exits nonzero -> wrapper exits with that exact status;
#     the CLI and post-hook do not run.
#   - pre-hook timeout -> 124; pre-hook command not found -> 127; any other
#     failure to run the pre-hook -> 126.
#   - pre-hook prints {{"decision": "deny"}} -> 1.
#   - pre-hook prints output that is not a JSON object -> 1.
#   - otherwise the CLI runs once; the post-hook is informational, except
#     cancellation signals received while running it cancel the wrapper.

import json
import os
import signal
import subprocess
import sys

ORIGINAL = "{original_path}"
PRE_HOOK = "{pre_hook}"
POST_HOOK = "{post_hook}"
HOOK_TIMEOUT = {hook_timeout}

EXIT_DENY = 1
EXIT_HOOK_ERROR = 126
EXIT_NOT_FOUND = 127
EXIT_TIMEOUT = 124
MAX_HOOK_JSON_NESTING = 64


def _pre_hook_json_too_deep(text):
    """Reject deeply nested hook JSON (CPython 3.14+ may parse without RecursionError)."""
    depth = 0
    in_string = False
    escape = False
    for ch in text:
        if in_string:
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == '"':
                in_string = False
            continue
        if ch == '"':
            in_string = True
        elif ch in "{{[":
            depth += 1
            if depth > MAX_HOOK_JSON_NESTING:
                return True
        elif ch in "}}]":
            if depth > 0:
                depth -= 1
    return False


class _HookCancelled(Exception):
    def __init__(self, signum):
        self.signum = signum


def _signal_exit_status(signum):
    return 128 + signum


def fail(message, status):
    """Print a fixed diagnostic (never hook payload or exception text) and exit."""
    print(f"Error: {{message}}", file=sys.stderr)
    sys.exit(status)


def _signal_hook_group(process, signum):
    if os.name == "posix":
        try:
            os.killpg(process.pid, signum)
        except ProcessLookupError:
            pass
    elif process.poll() is None:
        process.kill()


def _terminate_hook(process, signum):
    if os.name == "posix":
        _signal_hook_group(process, signum)
        _signal_hook_group(process, signal.SIGKILL)
    elif process.poll() is None:
        process.kill()
    process.communicate()


def run_with_timeout(command, input_data):
    """Run a hook in its own process group; reap it on timeout or cancellation."""
    if not command:
        raise ValueError("empty hook command")
    process = None
    pending_signal = None
    previous_handlers = {{}}

    def handle_signal(signum, _frame):
        nonlocal pending_signal
        if process is None:
            pending_signal = signum
            return
        raise _HookCancelled(signum)

    try:
        if os.name == "posix":
            for signum in (signal.SIGINT, signal.SIGTERM):
                previous_handlers[signum] = signal.signal(signum, handle_signal)
        if pending_signal is not None:
            raise _HookCancelled(pending_signal)
        process = subprocess.Popen(
            command,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=os.name == "posix",
        )
        if pending_signal is not None:
            raise _HookCancelled(pending_signal)
        stdout, stderr = process.communicate(input_data, timeout=HOOK_TIMEOUT)
        return subprocess.CompletedProcess(
            command, process.returncode, stdout, stderr
        )
    except subprocess.TimeoutExpired:
        for signum in previous_handlers:
            signal.signal(signum, signal.SIG_IGN)
        if process is not None:
            _signal_hook_group(process, signal.SIGKILL)
            process.communicate()
        raise
    except _HookCancelled as cancelled:
        for signum in previous_handlers:
            signal.signal(signum, signal.SIG_IGN)
        if process is not None:
            _terminate_hook(process, cancelled.signum)
        raise
    except BaseException:
        for signum in previous_handlers:
            signal.signal(signum, signal.SIG_IGN)
        if process is not None:
            _signal_hook_group(process, signal.SIGKILL)
            process.communicate()
        if pending_signal is not None:
            raise _HookCancelled(pending_signal)
        raise
    finally:
        for signum, previous_handler in previous_handlers.items():
            signal.signal(signum, previous_handler)


def run_pre_hook(payload):
    """Run the pre-hook; exit on failure or deny, return on allow."""
    try:
        result = run_with_timeout(
            PRE_HOOK.split(),
            json.dumps(payload).encode("utf-8"),
        )
    except _HookCancelled as cancelled:
        fail("pre-hook cancelled", _signal_exit_status(cancelled.signum))
    except subprocess.TimeoutExpired:
        fail("pre-hook timed out", EXIT_TIMEOUT)
    except FileNotFoundError:
        fail("pre-hook command not found", EXIT_NOT_FOUND)
    except (OSError, ValueError, UnicodeError):
        fail("pre-hook could not be run", EXIT_HOOK_ERROR)

    if result.returncode != 0:
        status = result.returncode if result.returncode > 0 else 128 - result.returncode
        fail(f"pre-hook failed (exit {{status}})", status)

    try:
        raw_out = result.stdout.decode("utf-8")
    except UnicodeDecodeError:
        fail("pre-hook returned malformed output", EXIT_DENY)
    if not raw_out.strip(" \t\r\n"):
        return
    if _pre_hook_json_too_deep(raw_out):
        fail("pre-hook returned malformed output", EXIT_DENY)
    try:
        decoder = json.JSONDecoder(parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))
        start = len(raw_out) - len(raw_out.lstrip(" \t\r\n"))
        parsed, end = decoder.raw_decode(raw_out, start)
        if raw_out[end:].strip(" \t\r\n") or not isinstance(parsed, dict):
            raise ValueError
    except (ValueError, RecursionError):
        fail("pre-hook returned malformed output", EXIT_DENY)
    if parsed.get("decision") == "deny":
        fail("Blocked by pre-hook", EXIT_DENY)


def run_post_hook(payload):
    """Run the post-hook; its outcome never affects the wrapper status."""
    try:
        run_with_timeout(
            POST_HOOK.split(),
            json.dumps(payload).encode("utf-8"),
        )
    except _HookCancelled as cancelled:
        sys.exit(_signal_exit_status(cancelled.signum))
    except (subprocess.SubprocessError, OSError, ValueError, UnicodeError):
        print("Hook warning: post-hook did not complete", file=sys.stderr)


def main():
    args = sys.argv[1:]
    cwd = os.getcwd()

    # Pre-hook
    if PRE_HOOK:
        run_pre_hook({{"cli": "{cli_name}", "args": args, "cwd": cwd, "phase": "pre"}})

    # Run original CLI exactly once and keep its status
    try:
        exit_code = subprocess.run([ORIGINAL] + args).returncode
    except FileNotFoundError:
        fail("original CLI not found", EXIT_NOT_FOUND)
    if exit_code < 0:
        exit_code = 128 - exit_code

    # Post-hook
    if POST_HOOK:
        run_post_hook(
            {{
                "cli": "{cli_name}",
                "args": args,
                "cwd": cwd,
                "exit_code": exit_code,
                "phase": "post",
            }}
        )

    sys.exit(exit_code)


if __name__ == "__main__":
    main()
