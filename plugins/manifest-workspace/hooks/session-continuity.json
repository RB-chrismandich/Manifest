{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/session-checkpoint/scripts/session_continuity.py\" hook-event --harness claude",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/session-checkpoint/scripts/session_continuity.py\" hook-event --harness claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
