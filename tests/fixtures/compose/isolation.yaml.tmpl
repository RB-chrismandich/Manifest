services:
  web:
    image: w:1
    user: "1000:1000"
    ports: ["80:80"]
    networks: %s
    logging: {driver: json-file, options: {max-size: 10m, max-file: "3"}}
    deploy: {resources: {limits: {cpus: "1", memory: 1G}}}
  db:
    image: postgres:16
    user: "1000:1000"
    networks: %s
    stop_grace_period: 30s
    volumes: [db_data:/var/lib/postgresql/data]
    logging: {driver: json-file, options: {max-size: 10m, max-file: "3"}}
    deploy: {resources: {limits: {cpus: "1", memory: 1G}}}
volumes:
  db_data:
networks:
  app-net: {driver: bridge}
  db-net: {internal: true}
