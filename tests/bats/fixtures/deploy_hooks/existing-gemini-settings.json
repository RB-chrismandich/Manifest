{
  "mcpServers": {
    "user-server": {
      "url": "https://example.test"
    }
  },
  "hooks": {
    "BeforeTool": [
      {
        "hooks": [
          {
            "name": "guidance-hint",
            "type": "command",
            "command": "~/.claude/scripts/guidance_hint.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "name": "version-pin",
            "type": "command",
            "command": "~/.claude/scripts/version_pin_hook.sh",
            "timeout": 30000
          },
          {
            "name": "spec-review",
            "type": "command",
            "command": "~/.claude/scripts/spec_review.sh --silent",
            "timeout": 120000
          },
          {
            "name": "lint-on-edit",
            "type": "command",
            "command": "~/.claude/scripts/lint_on_edit_hook.sh",
            "timeout": 30000
          }
        ]
      },
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "name": "version-pin",
            "type": "command",
            "command": "/opt/user-hooks/keep-me.sh",
            "timeout": 30000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "deploy-stamp-check",
            "type": "command",
            "command": "~/.claude/scripts/deploy_stamp_check.sh",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
