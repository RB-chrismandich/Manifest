{
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/scripts/guidance_hint.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/scripts/version_pin_hook.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/scripts/spec_review.sh --silent"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/scripts/lint_on_edit_hook.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/user-hooks/keep-me.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/scripts/deploy_stamp_check.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(/opt/user-hooks/keep-before.sh:*)",
      "Bash(~/.claude/scripts/version_pin.sh:*)",
      "Bash(~/.claude/scripts/guidance_hint.py:*)",
      "Bash(~/.claude/scripts/version_pin.sh --check:*)",
      "Bash(~/.claude/scripts/version_pin_hook.sh:*)",
      "Bash(/opt/user-hooks/keep-after.sh:*)"
    ]
  }
}
