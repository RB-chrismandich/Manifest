# Agent Output Directory (runtime files, logs, temp outputs)
.claude/.agent_outputs/
configs/claude/.agent_outputs/

# Generated by `skillshare sync` (Copilot target). Source of truth is
# .skillshare/skills/; this is a derived copy, regenerated by bootstrap.
.github/skills/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node (bats test runner installed via npm in CI / locally)
node_modules/
package-lock.json

# local tool side-effect, origin unknown (not SkillClaw — see specs/003 research R10)
records/

# Logs
*.log

# Temp files
*.tmp
.tmp-*
.tmp-*/

# spec-review runtime (feedback, content-hash, lock, error log)
.spec-review/

# skill-creator eval workspaces (iteration outputs, benchmarks, rework runs)
*-workspace/

# spec 362: user-local guidance overrides are machine-local (created lazily on
# first opt-out under ~/.claude/config/) — never commit them. The shipped
# defaults live in configs/claude/config/guidance.yml (tracked).
guidance_local.yml

# Transient smoke-test JUnit output (smoke_test.py default --junit)
smoke-report.xml
# Transient per-catalog write lock (smoke_test.py append)
smoke-catalog/*.lock

# uv lockfile — intentionally untracked (#523). pyproject.toml is the source
# of truth (ruff/pytest/pyright config + the optional [dependency-groups]
# benchmark group, #547); resolution is reproducible from it on demand.
uv.lock
benchmark_data/
