{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "checks", "profiles", "debt_baseline", "preservation"],
  "properties": {
    "schema_version": {"const": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "group", "category", "argv", "cwd", "inputs", "dependencies", "timeout_seconds", "selection", "tool", "version", "honors_status_contract"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "group": {"enum": ["lint", "test", "structure", "security", "package"]},
          "category": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"$ref": "#/$defs/candidatePath"},
          "inputs": {"type": "array", "items": {"$ref": "#/$defs/candidatePath"}},
          "dependencies": {"type": "array", "items": {"$ref": "#/$defs/candidatePath"}},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
          "selection": {"type": "string", "minLength": 1},
          "tool": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "honors_status_contract": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "profiles": {
      "type": "object",
      "required": ["quick", "full", "security", "release"],
      "properties": {
        "quick": {"$ref": "#/$defs/profile"},
        "full": {"$ref": "#/$defs/profile"},
        "security": {"$ref": "#/$defs/profile"},
        "release": {"$ref": "#/$defs/profile"}
      },
      "additionalProperties": false
    },
    "debt_baseline": {"$ref": "#/$defs/candidatePath"},
    "preservation": {"$ref": "#/$defs/candidatePath"}
  },
  "$defs": {
    "candidatePath": {
      "type": "string",
      "minLength": 1,
      "not": {"anyOf": [{"pattern": "^/"}, {"pattern": "^[A-Za-z]:[/\\\\]"}, {"pattern": "(^|/)\\.\\.(/|$)"}]}
    },
    "profile": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false
}
